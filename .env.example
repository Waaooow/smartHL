# contoh: cp .env.example .env lalu isi yang bertanda wajib
APP_PORT=5000
MQTT_PORT=1883
MQTT_WS_PORT=9001
# random 32 char, cth hasil: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-random-32-char
# --- MariaDB ---
# Mode A (bawaan): DB_HOST=mariadb + nyalakan service-nya (lihat atas).
# Mode B (server database terpisah): isi ke host database-mu.
#   Pastikan di server DB: user boleh remote + port 3306 terbuka.
#   Contoh di server DB (mysql -u root -p):
#     CREATE DATABASE smarthl CHARACTER SET utf8mb4;
#     CREATE USER 'smarthl'@'%' IDENTIFIED BY 'isi-random';
#     GRANT ALL ON smarthl.* TO 'smarthl'@'%'; FLUSH PRIVILEGES;
DB_NAME=smarthl
DB_USER=smarthl
DB_PASS=wajib-ganti
DB_ROOT_PASS=wajib-ganti-juga
DB_HOST=mariadb
DB_PORT=3306
# dibuat oleh scripts/sync-mqtt-auth.py -> mosquitto/auth/bridge.env (jangan commit)
BRIDGE_PASSWORD=isi-dari-bridge.env
# 1 hanya bila dashboard diakses via HTTPS (prod + TLS). Di HTTP lokal biarkan 0.
SECURE_COOKIES=0
# hapus telemetri lebih tua dari N hari (0 = mati). Jalan saat start + harian.
TELEMETRY_RETENTION_DAYS=90
